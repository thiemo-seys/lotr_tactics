{$DOMAIN} {
	# The game server sends files uncompressed. Woff2 fonts are compressed already.
	encode {
		zstd
		gzip
		match {
			header Content-Type text/*
			header Content-Type application/json*
			header Content-Type image/svg+xml*
			header Content-Type model/gltf-binary*
		}
	}

	# Vite puts a hash in these file names, so they never change.
	header /assets/* Cache-Control "public, max-age=31536000, immutable"

	# WebSocket upgrades on /ws pass through as well.
	reverse_proxy game:8080
}
