{
  "name": "lotr-tactics",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "dev": "pnpm --parallel --filter @lotr-tactics/client --filter @lotr-tactics/server dev",
    "start": "pnpm build && pnpm --filter @lotr-tactics/server start",
    "lint": "eslint .",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r test",
    "build": "pnpm -r --if-present build",
    "check": "pnpm lint && pnpm typecheck && pnpm test && pnpm build",
    "balance": "pnpm --filter @lotr-tactics/sim balance",
    "models": "pnpm --filter @lotr-tactics/client models"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.13.0",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.72.1"
  }
}
